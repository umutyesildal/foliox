# FolioX frontend (app/) — build-time env vars (NEXT_PUBLIC_* are inlined by
# Next at build time; restart `npm run dev` / rebuild after changing them).

# Backend API base (backend/src/api/server.ts). Default: http://localhost:3001.
# Points the /explore, /stocks, basket detail, create wizard and home pages at
# the FolioX API (/api/v1/...).
NEXT_PUBLIC_API=http://localhost:3001

# Solana cluster for the whole UI: "devnet" | "testnet" | "mainnet-beta" |
# "localnet". Default when unset: devnet (devnet-showcase repo state). Drives
# the header network indicator AND every explorer.solana.com link
# (devnet → ?cluster=devnet, localnet → ?cluster=custom&customUrl=<RPC>).
NEXT_PUBLIC_CLUSTER=devnet

# RPC endpoint override. Default: the well-known public endpoint for
# NEXT_PUBLIC_CLUSTER (devnet → https://api.devnet.solana.com,
# localnet → http://127.0.0.1:8899). Set this alone (without
# NEXT_PUBLIC_CLUSTER) and the cluster label is derived from the host.
#NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
