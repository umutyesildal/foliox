# FolioX backend — DEVNET profile (dot-env format; load explicitly, e.g.
#   set -a; . backend/.env.devnet; set +a; npm run dev   — from backend/)
# The backend NEVER signs transactions and NEVER holds keys (AGENTS.md §2 #5):
# there is deliberately NO payer keypair / secret in this file. The deploy
# authority wallet (y72KA263br7MtZw7BqC2dx5QYCBUciJGzShE8BRSwRE) belongs to the
# deploy scripts only, never to this process.

# --- Postgres (local convention from backend/.env, SEPARATE database name) ---
# Create the database before first run (backend only documents the name, it
# never creates databases):  createdb foliox_devnet
DATABASE_URL=postgres://umutyesildal@localhost:5432/foliox_devnet

# --- Solana RPC (devnet; read-only usage: indexer polling + supply reads) ----
RPC_URL=https://api.devnet.solana.com

# --- Indexed programs (final devnet addresses) -------------------------------
PROGRAM_WHITELIST=FRavMcYQb2FVAHbbG6fGieQHdKk1UrQqgKsAAXTPRQeS
PROGRAM_FACTORY=3hzoPep9JKgTmzLT6CNW5x3EN7WNYDevM6KHVM7pLgMF
PROGRAM_BASKET=6Q43vFh4aqGxzvtU2vQwJX9PmX3skfYsGWZdA3fwJB9k

# --- API port -----------------------------------------------------------------
PORT=3001

# --- NAV engine (explicit on; "0" would disable) ------------------------------
NAV_ENGINE=1
NAV_INTERVAL_MS=60000
NAV_RANKINGS_REFRESH_MS=300000

# --- Fee crank ----------------------------------------------------------------
# !!! LOUD WARNING: the fee crank ONLY EVER BUILDS UNSIGNED
# !!! accrue_management_fee TRANSACTIONS. It cannot sign, holds no keys, and
# !!! broadcasts nothing — a keeper must sign + submit externally
# !!! (AGENTS.md §2 #5). FEE_CRANK=1 merely enables the hourly tx BUILDER.
FEE_CRANK=1
FEE_CRANK_MS=3600000
# Optional: real fee-payer pubkey for the built (unsigned) txs; without it a
# placeholder feePayer is used and keepers must patch it before signing.
# FEE_CRANK_PAYER_PUBKEY=

# --- Indexer polling (read-only getSignaturesForAddress loop) -----------------
# Devnet pacing (shared public RPC): 30s poll cadence, 20 sigs per batch, and a
# 60s vault_holdings refresh (schema §7 default is 30s; relaxed here because
# holdings are demo-only on devnet). All RPC reads additionally go through the
# shared 429 backoff (src/rpc/backoff.ts: exponential + jitter, 60s cap,
# ≤1 warn line/min) and are spaced so a pass cannot burst its reads.
INDEXER_POLL_MS=30000
INDEXER_POLL_LIMIT=20
HOLDINGS_SYNC_INTERVAL_MS=60000

# --- Cache (optional; leave unset to use the in-memory TTL map) ---------------
# REDIS_URL=redis://localhost:6379

# --- Prices -------------------------------------------------------------------
# Deliberately NOT setting PRICE_FALLBACK=mock: mock xStocks are priced through
# the dev catalog via their whitelisted_mints "mock:<slug>" labels
# (workers/mockPriceFill.ts, source "mock"). The PRICE_FALLBACK=mock flag would
# only add price-0 "mock" placeholders for mints with no real price.
# PRICE_FALLBACK=

# --- Realistic mock prices (real equity quotes for the mock xStocks) ---------
# REALISTIC_MOCK_PRICES=1 → "mock:<slug>" whitelist mints are priced from the
# REAL US-equity market first, via the guarded Yahoo chart API
# (workers/realisticMockPrices.ts; slug→ticker table MOCK_SLUG_TO_TICKER in
# catalog/mockStocks.ts; 60s in-memory TTL, spaced sequential fetches). Yahoo
# quotes are labeled source "yahoo" in nav_snapshots price_source; on ANY
# Yahoo failure the deterministic dev catalog is used per-symbol (source
# "mock"). Unset/0 ⇒ catalog-only (deterministic local-dev prices).
REALISTIC_MOCK_PRICES=1

# --- Chain-truth user_positions reconciliation -------------------------------
# Periodic pass that reads each indexed basket's share-mint token accounts
# (getProgramAccounts on Token-2022, mint memcmp filter) and upserts
# user_positions from ACTUAL balances — the durable fix for Minted/Redeemed
# events lost to log truncation on 6+-constituent baskets. Rows created this
# way carry cost_basis_source = 'balance-sync' (honest provenance); event-
# derived cost basis is never overwritten. Default 120000ms when unset.
POSITIONS_SYNC_MS=120000
